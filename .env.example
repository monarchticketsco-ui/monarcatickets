# Supabase — supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publica del sitio (usada para armar la callback_url del link de pago Bold)
NEXT_PUBLIC_SITE_URL=

# Bold — developers.bold.co (pedir llaves de sandbox primero)
BOLD_API_KEY=
BOLD_WEBHOOK_SECRET=

# Boletos con QR (Fase 2.1) — opcional: si se deja vacia, se firma con
# SUPABASE_SERVICE_ROLE_KEY para que funcione sin configuracion extra.
# Recomendado configurarla aparte cuando se construya el escaneo en puerta.
TICKET_QR_SECRET=

# Correo de confirmacion de compra (Fase 2.1) — resend.com/api-keys.
# Sin un dominio verificado en resend.com/domains, Resend solo deja
# enviar al correo del dueno de la cuenta (modo pruebas).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Monarca Tickets <onboarding@resend.dev>"

# Facturacion electronica DIAN — elegir Factus o Alegra
FACTUS_API_KEY=
FACTUS_API_SECRET=
# ALEGRA_EMAIL=
# ALEGRA_TOKEN=
